{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"strict": true,
		"noEmit": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["vite/client"]
	},
	"include": [
		"client/src/**/*.js",
		"client/src/**/*.svelte",
		"engine/**/*.js"
	]
}
